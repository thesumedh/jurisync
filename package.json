{
  "name": "jurisync",
  "version": "1.0.1",
  "description": "Development-Time Cross-Jurisdictional Compliance Orchestration Layer for AI-Assisted Software Engineering",
  "type": "module",
  "main": "./src/engine/orchestrator.js",
  "bin": {
    "jurisync": "mcp-server.js"
  },
  "exports": {
    ".": "./src/engine/orchestrator.js",
    "./rules": "./src/data/rules.js",
    "./package.json": "./package.json"
  },
  "files": [
    "mcp-server.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mcp": "node mcp-server.js",
    "test": "node tests/verify-target-flow.js && node tests/verify-slice2.js && node tests/verify-slice3.js && node tests/verify-slice4.js && node tests/verify-slice5.js"
  },
  "keywords": [
    "compliance",
    "mcp",
    "model-context-protocol",
    "ai-governance",
    "eu-ai-act",
    "gdpr",
    "dpdp",
    "nist-ai-rmf",
    "responsible-ai",
    "regulatory-intelligence"
  ],
