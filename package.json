  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesumedh/jurisync.git"
  },
  "homepage": "https://jurisync-one.vercel.app/",
  "bugs": {
    "url": "https://github.com/thesumedh/jurisync/issues"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  }
}
